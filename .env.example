# ---------------------------------------------------------------------------
# SEO Portfolio Dashboard — environment
#
# Copy to `.env.local` and fill in. Everything here is read ONLY on the server
# (see lib/env.ts, which is guarded by `server-only`). Nothing in this file is
# prefixed NEXT_PUBLIC_, so none of it can reach the browser bundle.
# ---------------------------------------------------------------------------

# Which provider backs the service layer: `mock` or `google`.
# Leave as mock to run the dashboard with no Google setup at all.
DATA_SOURCE=mock

# ---------------------------------------------------------------------------
# Google service account
#
# 1. Create a service account in Google Cloud and download its JSON key.
# 2. Enable the "Google Analytics Data API" and "Search Console API".
# 3. Grant the service-account email read access on each property:
#      - GA4:  Admin > Property Access Management > add as Viewer
#      - GSC:  Settings > Users and permissions > add as Full/Restricted user
#
# GOOGLE_PRIVATE_KEY must keep its literal \n sequences and stay quoted —
# lib/env.ts converts them back to real newlines before signing.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=""
GOOGLE_PROJECT_ID=

# ---------------------------------------------------------------------------
# Per-property bindings
#
# The suffix after the last underscore is the site's `envKey` in
# lib/websites.ts (The Doc Mirror is TDM). It is intentionally independent of
# the URL slug, so renaming a route never forces an env var rename here.
#
# GA4_PROPERTY_*  — the numeric GA4 property id (Admin > Property Settings),
#                   digits only, no "properties/" prefix.
# GSC_PROPERTY_*  — `sc-domain:example.com` for a Domain property, or the exact
#                   URL-prefix property including the trailing slash.
#
# These are identifiers, not credentials. A site left blank is reported as
# "Not connected yet" in the UI rather than rendering as zeros.
# ---------------------------------------------------------------------------
GA4_PROPERTY_TDM=
GSC_PROPERTY_TDM=sc-domain:thedocmirror.com

GA4_PROPERTY_NEXTDOT=
GSC_PROPERTY_NEXTDOT=sc-domain:nextdot.co.in

GA4_PROPERTY_FWDPOD=
GSC_PROPERTY_FWDPOD=sc-domain:fwdpod.com

GA4_PROPERTY_SHOPYUKTI=
GSC_PROPERTY_SHOPYUKTI=sc-domain:shopyukti.com

# ---------------------------------------------------------------------------
# GEO monitoring — AI answer-engine visibility
#
# Optional and independent. A provider with no key renders as "Not configured"
# on the GEO page rather than failing the scan.
#
# Each scan costs real money on the key owner's account: 6 prompts x 3 runs =
# 18 calls per provider, per scan. The Competitors page shares these keys.
#
#   OPENAI_API_KEY     → ChatGPT   (platform.openai.com/api-keys)
#   GEMINI_API_KEY     → Gemini    (aistudio.google.com/apikey)
#   ANTHROPIC_API_KEY  → Claude    (console.anthropic.com/settings/keys)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Model overrides. Defaults are the cheap tier of each vendor.
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-5

# Required: the code default (gemini-2.0-flash) has been retired and 404s.
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Knowledge Graph
#
# An API key, not the service account above — the Knowledge Graph Search API
# authenticates with a key while GA4/GSC use OAuth. Free to use.
# Enable "Knowledge Graph Search API" in Google Cloud, then create an API key.
# GOOGLE_API_KEY is accepted as a fallback.
# ---------------------------------------------------------------------------
KNOWLEDGE_GRAPH_API_KEY=

# ---------------------------------------------------------------------------
# Tuning
# ---------------------------------------------------------------------------

# Seconds an API response stays warm. 0 disables caching.
# Google's quotas are per-property per-day, so caching is what keeps a few
# people refreshing the dashboard from exhausting them.
DATA_CACHE_TTL=300

# Artificial latency for the mock provider, in ms. Set 0 to remove it.
MOCK_LATENCY=120
